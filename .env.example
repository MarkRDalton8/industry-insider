# Piano Configuration
# Get these from your Piano dashboard (dashboard.piano.io)

# Application ID — found in Piano dashboard > Settings > General
NEXT_PUBLIC_PIANO_AID=

# Set to "true" to use Piano sandbox environment (sandbox.tinypass.com)
# Leave empty or "false" for production (experience.tinypass.com)
NEXT_PUBLIC_PIANO_SANDBOX=false

# Piano Analytics — found in Piano Analytics dashboard > Settings
NEXT_PUBLIC_PIANO_ANALYTICS_SITE=
NEXT_PUBLIC_PIANO_ANALYTICS_DOMAIN=

# Piano ESP (Email) — found in Piano DMP > Settings > SDK
NEXT_PUBLIC_PIANO_ESP_HASH=

# Piano Offer ID — found in Piano Composer > Offers
NEXT_PUBLIC_PIANO_OFFER_ID=

# Piano Resource ID — found in Piano Dashboard > Resources
# Used for access checks (paywall)
NEXT_PUBLIC_PIANO_RESOURCE_ID=

# --- Optional: AI Publisher (feature flag: features.aiPublisher) ---
OPENWEBUI_API_KEY=
OPENWEBUI_ENDPOINT=https://llm.de-prod.cxense.com/
OPENWEBUI_MODEL=us.anthropic.claude-opus-4-6-v1

# --- Optional: Publisher API (for custom fields CLI) ---
PIANO_API_TOKEN=
